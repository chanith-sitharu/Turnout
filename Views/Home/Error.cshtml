@model TurnoutStore.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error - The Turnout Store";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 p-5">
                <div class="text-danger mb-3">
                    <i class="fas fa-exclamation-circle fa-4x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Something Went Wrong</h2>
                <p class="text-secondary mb-4">
                    An error occurred while processing your request. Our workshop team has been notified.
                </p>

                @if (Model != null && Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-muted mb-4 py-2">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-warning fw-bold px-4">
                        <i class="fas fa-home me-1"></i> Return to Catalog
                    </a>
                    <a href="https://wa.me/94703856824" target="_blank" class="btn btn-outline-success fw-bold px-4">
                        <i class="fab fa-whatsapp me-1"></i> WhatsApp Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>