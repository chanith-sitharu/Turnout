@{
    ViewData["Title"] = "Privacy Policy - The Turnout Store";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-3"><i class="fas fa-shield-alt text-warning me-2"></i>Privacy Policy</h1>
            <p class="text-secondary">Last updated: @DateTime.UtcNow.ToString("MMMM dd, yyyy")</p>
            <hr class="my-4" />

            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold text-dark mb-3">1. Information We Collect</h5>
                <p class="text-muted">
                    When you place an order, create an account, or reserve an exhibition tour at The Turnout Store, we collect personal information such as your name, email address, phone number, and physical shipping address strictly for order fulfillment, customer support, and reservation communications.
                </p>

                <h5 class="fw-bold text-dark mb-3">2. Data Security &amp; Storage</h5>
                <p class="text-muted">
                    We employ industry-standard cryptographic hashing (PBKDF2 with SHA-512) to protect account passwords. Sensitive session and authentication cookies are stored securely with strict HTTP-only and Lax/Strict policies.
                </p>

                <h5 class="fw-bold text-dark mb-3">3. Third-Party Sharing</h5>
                <p class="text-muted">
                    We do not sell, rent, or trade your personal information. Shipping details are shared solely with verified carrier and courier partners to ensure safe delivery of your handcrafted miniatures.
                </p>

                <h5 class="fw-bold text-dark mb-3">4. Contact Information</h5>
                <p class="text-muted mb-0">
                    If you have questions regarding this Privacy Policy or wish to request data deletion, contact us at <a href="mailto:info@theturnout.lk">info@theturnout.lk</a> or via WhatsApp at <strong>+94 70 385 6824</strong>.
                </p>
            </div>
        </div>
    </div>
</div>