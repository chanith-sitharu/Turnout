@model TurnoutStore.Data.TicketBooking
@{
    Layout = null;
    var isForeign = Model.TicketType.Contains("Foreign", StringComparison.OrdinalIgnoreCase);
    var currency = isForeign ? "USD" : "LKR";
    var symbol = isForeign ? "$" : "Rs. ";
    var adultRate = isForeign ? 10.00m : 1000.00m;
    var childRate = isForeign ? 5.00m : 500.00m;
    var adultTotal = Model.AdultsCount * adultRate;
    var childTotal = Model.KidsCount * childRate;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Ticket Bill #TB-@Model.BookingId.ToString("D5") - The Turnout Store</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f5f5f5;
            color: #000;
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            line-height: 1.35;
        }

        /* 80mm Thermal Receipt Layout */
        .ticket-receipt {
            max-width: 80mm;
            width: 100%;
            margin: 15px auto;
            padding: 12px 10px;
            background: #fff;
            border: 1px solid #ddd;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .center {
            text-align: center;
        }

        .left {
            text-align: left;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .store-title {
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .receipt-title {
            font-size: 13px;
            font-weight: bold;
            margin: 4px 0;
            text-transform: uppercase;
        }

        .dashed-divider {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }

        .double-divider {
            border-top: 2px solid #000;
            margin: 8px 0;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 4px 0;
        }

        .items-table th {
            border-bottom: 1px dashed #000;
            padding: 3px 0;
            font-size: 11px;
            text-align: left;
        }

        .items-table td {
            padding: 3px 0;
            font-size: 11px;
        }

        .total-box {
            font-size: 13px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
        }

        .barcode-section {
            text-align: center;
            margin: 8px 0 4px 0;
            letter-spacing: 2px;
            font-size: 13px;
        }

        .barcode-lines {
            font-family: 'Libre Barcode 39', 'Courier New', monospace;
            font-size: 24px;
            line-height: 1;
            letter-spacing: 1px;
        }

        .footer-note {
            font-size: 10px;
            text-align: center;
            margin-top: 6px;
            line-height: 1.25;
        }

        /* Floating print toolbar for desktop preview */
        .no-print-toolbar {
            max-width: 80mm;
            margin: 10px auto;
            text-align: center;
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn-thermal {
            padding: 6px 14px;
            font-size: 12px;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            border-radius: 4px;
            border: 1px solid #333;
            background: #222;
            color: #fff;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-thermal:hover {
            background: #444;
        }

        .btn-secondary {
            background: #fff;
            color: #222;
            border-color: #bbb;
        }

        /* Printer Media Rules */
        @@media print {
            @@page {
                margin: 0;
                size: 80mm auto;
            }

            body {
                background: #fff;
                padding: 0;
                margin: 0;
            }

            .ticket-receipt {
                max-width: 80mm;
                width: 80mm;
                margin: 0;
                padding: 4mm 3mm;
                border: none;
                box-shadow: none;
            }

            .no-print,
            .no-print-toolbar {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <!-- Screen-only Toolbar -->
    <div class="no-print-toolbar no-print">
        <button class="btn-thermal" onclick="window.print()">🖨️ Print Bill Now</button>
        <button class="btn-thermal btn-secondary" onclick="window.close()">Close Window</button>
    </div>

    <!-- 80mm Thermal Receipt Canvas -->
    <div class="ticket-receipt">
        <!-- Store Header -->
        <div class="center">
            <img src="/images/logo.png" alt="Logo" style="width: 50px; height: 50px; object-fit: contain; margin-bottom: 4px; filter: grayscale(100%);" />
            <div class="store-title">THE TURNOUT MODELRAILWAY</div>
            <div>Scale Miniatures &amp; Railways</div>
            <div>18th Mile Post, Cemetery Rd, WP</div>
            <div>WhatsApp: +94 70 385 6824</div>
        </div>

        <div class="double-divider"></div>

        <!-- Receipt Title -->
        <div class="center receipt-title">EXHIBITION TICKET BILL</div>

        <div class="dashed-divider"></div>

        <!-- Metadata -->
        <div class="info-row">
            <span>Bill No:</span>
            <span class="bold">#TB-@Model.BookingId.ToString("D5")</span>
        </div>
        <div class="info-row">
            <span>Issue Date:</span>
            <span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="info-row">
            <span>Category:</span>
            <span class="bold">@(isForeign ? "Foreign Guest" : "Local Resident")</span>
        </div>
        <div class="info-row">
            <span>Payment:</span>
            <span class="bold">PAID / @Model.BookingStatus.ToUpperInvariant()</span>
        </div>

        <div class="dashed-divider"></div>

        <!-- Visitor Info -->
        <div class="info-row">
            <span>Customer:</span>
            <span class="bold">@Model.CustomerName</span>
        </div>
        <div class="info-row">
            <span>Phone:</span>
            <span>@Model.PhoneNumber</span>
        </div>
        <div class="info-row">
            <span>Visit Date:</span>
            <span class="bold">@Model.VisitDate.ToString("yyyy-MM-dd (ddd)")</span>
        </div>
        <div class="info-row">
            <span>Time Slot:</span>
            <span class="bold">@Model.TimeSlot</span>
        </div>

        <div class="dashed-divider"></div>

        <!-- Pax Breakdown Table -->
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 48%;">DESCRIPTION</th>
                    <th class="center" style="width: 14%;">QTY</th>
                    <th class="right" style="width: 18%;">RATE</th>
                    <th class="right" style="width: 20%;">AMOUNT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Adult Ticket</td>
                    <td class="center">@Model.AdultsCount</td>
                    <td class="right">@adultRate.ToString("N0")</td>
                    <td class="right">@adultTotal.ToString("N2")</td>
                </tr>
                @if (Model.KidsCount > 0)
                {
                    <tr>
                        <td>Child Ticket</td>
                        <td class="center">@Model.KidsCount</td>
                        <td class="right">@childRate.ToString("N0")</td>
                        <td class="right">@childTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="dashed-divider"></div>

        <!-- Total Price -->
        <div class="total-box">
            <span>TOTAL PAID (@currency):</span>
            <span>@symbol@Model.TotalPrice.ToString("N2")</span>
        </div>

        <div class="dashed-divider"></div>

        <!-- Barcode Representation -->
        <div class="barcode-section">
            <div class="barcode-lines">||| | |||| | ||| |||| | || | |||</div>
            <div style="font-size: 10px; font-weight: bold;">*TB@(Model.BookingId.ToString("D6"))*</div>
        </div>

        <div class="dashed-divider"></div>

        <!-- Footer / Admission Notes -->
        <div class="footer-note">
            <div class="bold">ADMIT ONE PARTY • STUDIO TOUR</div>
            <div>Please present receipt at gallery entrance.</div>
            <div>Valid exclusively on scheduled date &amp; slot.</div>
            <div style="margin-top: 4px;">Thank you for supporting handcraft artisans!</div>
            <div>www.theturnout.lk</div>
        </div>
    </div>

    <!-- Auto Print Script -->
    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>
