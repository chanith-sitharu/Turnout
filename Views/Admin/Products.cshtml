@model IEnumerable<TurnoutStore.Data.Product>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Products - Admin";
}

<div class="container py-4">
    <!-- Breadcrumb / Navigation Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <h2 class="fw-bold mb-1 mt-1"><i class="fas fa-boxes text-warning me-2"></i>Product Catalog</h2>
            <p class="text-secondary mb-0">Add new handcrafted miniatures, modify inventory, and manage product listings.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateProduct" class="btn btn-warning fw-bold text-dark px-3 py-2 shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Add New Product
            </a>
            <a asp-action="Orders" class="btn btn-outline-secondary px-3 py-2">
                <i class="fas fa-boxes-packing me-1"></i> Orders
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Products Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="fw-bold text-dark">
                <i class="fas fa-table me-2 text-primary"></i>All Products
                <span class="badge bg-secondary ms-2">@(Model?.Count() ?? 0) Items</span>
            </div>
            <div class="text-muted small">
                Click <strong>Edit</strong> to modify details or <strong>Delete</strong> to deactivate.
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-secondary">
                            <tr>
                                <th class="ps-3" style="width: 140px;">SKU</th>
                                <th>Product Name</th>
                                <th>Scale</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-3" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- SKU & Type Icon / Image -->
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded me-2 border bg-white" style="width: 38px; height: 38px; object-fit: cover;" />
                                            }
                                            else if (item.Sku.Contains("LOCO"))
                                            {
                                                <i class="fas fa-train text-secondary me-2"></i>
                                            }
                                            else if (item.Sku.Contains("BLD") || item.Sku.Contains("STR"))
                                            {
                                                <i class="fas fa-building text-secondary me-2"></i>
                                            }
                                            else if (item.Sku.Contains("SCN"))
                                            {
                                                <i class="fas fa-tree text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-box text-primary me-2"></i>
                                            }
                                            <span class="fw-mono small fw-semibold">@item.Sku</span>
                                        </div>
                                    </td>

                                    <!-- Name & Attributes -->
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">
                                                @item.Description
                                            </small>
                                        }
                                    </td>

                                    <!-- Scale / Badges -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Scale))
                                        {
                                            <span class="badge bg-light text-dark border">@item.Scale</span>
                                        }
                                        @if (item.IsUnique)
                                        {
                                            <span class="badge bg-danger ms-1">Unique</span>
                                        }
                                    </td>

                                    <!-- Price -->
                                    <td class="text-end fw-bold text-dark">
                                        $@item.Price.ToString("N2")
                                    </td>

                                    <!-- Stock Quantity -->
                                    <td class="text-center">
                                        @if (item.StockQuantity > 5)
                                        {
                                            <span class="badge bg-success bg-opacity-75">@item.StockQuantity in stock</span>
                                        }
                                        else if (item.StockQuantity > 0)
                                        {
                                            <span class="badge bg-warning text-dark">Low (@item.StockQuantity)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-eye-slash me-1"></i>Inactive</span>
                                        }
                                    </td>

                                    <!-- Action Buttons -->
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="EditProduct" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary" title="Edit Product">
                                                <i class="fas fa-pencil-alt"></i> Edit
                                            </a>

                                            <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to soft-delete product \'@item.Name\'?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Soft Delete / Deactivate">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-box-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h5>No products registered yet</h5>
                    <p class="small mb-3">Add your first handcrafted miniature model to start selling.</p>
                    <a asp-action="CreateProduct" class="btn btn-warning fw-bold text-dark">
                        <i class="fas fa-plus me-1"></i> Add Product
                    </a>
                </div>
            }
        </div>
    </div>
</div>
