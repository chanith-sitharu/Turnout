@model IEnumerable<TurnoutStore.Data.BankAccount>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Store Bank Accounts - Admin";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted small">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <h2 class="fw-bold mt-1 mb-0"><i class="fas fa-university text-primary me-2"></i>Store Bank Accounts</h2>
            <p class="text-secondary mb-0">Configure the receiving bank accounts displayed to customers on checkout for bank transfer deposits.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createAccountModal">
                <i class="fas fa-plus me-1"></i> Add New Bank Account
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bank Accounts Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-secondary">
                        <tr>
                            <th class="ps-3" style="width: 70px;">#</th>
                            <th style="min-width: 180px;">Bank Name</th>
                            <th style="min-width: 180px;">Account Holder Name</th>
                            <th style="min-width: 160px;">Account Number</th>
                            <th style="min-width: 160px;">Branch</th>
                            <th style="min-width: 110px;">Status</th>
                            <th class="text-end pe-3" style="min-width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var account in Model)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@account.Id</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <i class="fas fa-landmark text-primary me-2"></i>@account.BankName
                                        </div>
                                    </td>
                                    <td class="fw-semibold text-secondary">
                                        @account.AccountName
                                    </td>
                                    <td>
                                        <span class="font-monospace fw-bold px-2 py-1 bg-light border rounded text-dark">
                                            @account.AccountNumber
                                        </span>
                                    </td>
                                    <td class="text-secondary">
                                        <i class="fas fa-code-branch me-1 text-muted"></i>@account.Branch
                                    </td>
                                    <td>
                                        @if (account.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                <i class="fas fa-check-circle me-1"></i>Active (Visible)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                <i class="fas fa-eye-slash me-1"></i>Inactive (Hidden)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <!-- Toggle Active/Inactive Form -->
                                            <form asp-action="ToggleBankAccount" asp-route-id="@account.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(account.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="Toggle visibility to customers">
                                                    <i class="fas @(account.IsActive ? "fa-pause" : "fa-play") me-1"></i>@(account.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>

                                            <!-- Edit Button (Modal Trigger) -->
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-primary" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editAccountModal"
                                                    onclick="populateEditModal(@account.Id, '@Html.Raw(account.BankName)', '@Html.Raw(account.AccountName)', '@account.AccountNumber', '@Html.Raw(account.Branch)', @account.IsActive.ToString().ToLower())">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </button>

                                            <!-- Delete Form -->
                                            <form asp-action="DeleteBankAccount" asp-route-id="@account.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this bank account?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete bank account">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-university fa-3x mb-3 text-secondary opacity-50"></i>
                                    <h5>No store receiving bank accounts configured yet.</h5>
                                    <p class="small text-secondary mb-3">Add your first bank account so customers can transfer funds during checkout.</p>
                                    <button type="button" class="btn btn-sm btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#createAccountModal">
                                        <i class="fas fa-plus me-1"></i> Add Account
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: ADD BANK ACCOUNT                   -->
<!-- ========================================== -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form asp-action="CreateBankAccount" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="createAccountModalLabel">
                        <i class="fas fa-plus-circle text-primary me-2"></i>Add Store Receiving Bank Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Bank Name *</label>
                        <input type="text" name="BankName" class="form-control" placeholder="e.g. Commercial Bank of Ceylon / BOC" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Holder Name *</label>
                        <input type="text" name="AccountName" class="form-control" placeholder="e.g. The Turnout Model Railway" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Number *</label>
                        <input type="text" name="AccountNumber" class="form-control font-monospace" placeholder="e.g. 8009234512" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Branch Name *</label>
                        <input type="text" name="Branch" class="form-control" placeholder="e.g. Negombo Branch" required />
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="createIsActive" checked />
                        <label class="form-check-label fw-semibold small" for="createIsActive">Active &amp; Visible to customers on checkout</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="fas fa-save me-1"></i> Save Bank Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: EDIT BANK ACCOUNT                     -->
<!-- ========================================== -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <form asp-action="EditBankAccount" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editAccountId" />

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editAccountModalLabel">
                        <i class="fas fa-edit text-warning me-2"></i>Edit Store Bank Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Bank Name *</label>
                        <input type="text" name="BankName" id="editBankName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Holder Name *</label>
                        <input type="text" name="AccountName" id="editAccountName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Number *</label>
                        <input type="text" name="AccountNumber" id="editAccountNumber" class="form-control font-monospace" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Branch Name *</label>
                        <input type="text" name="Branch" id="editBranch" class="form-control" required />
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive" />
                        <label class="form-check-label fw-semibold small" for="editIsActive">Active &amp; Visible to customers on checkout</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold px-4">
                        <i class="fas fa-check me-1"></i> Update Bank Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function populateEditModal(id, bankName, accountName, accountNumber, branch, isActive) {
        document.getElementById('editAccountId').value = id;
        document.getElementById('editBankName').value = bankName;
        document.getElementById('editAccountName').value = accountName;
        document.getElementById('editAccountNumber').value = accountNumber;
        document.getElementById('editBranch').value = branch;
        document.getElementById('editIsActive').checked = isActive;
    }
</script>
}
