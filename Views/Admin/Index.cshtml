@model TurnoutStore.Models.AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard - The Turnout Store";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-chart-line text-primary me-2"></i>Admin Dashboard</h2>
            <p class="text-secondary mb-0">Overview of store revenue, incoming orders, and fulfillment metrics.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Bookings" class="btn btn-dark fw-semibold">
                <i class="fas fa-ticket-alt me-1"></i> Bookings
            </a>
            <a asp-action="Products" class="btn btn-warning fw-semibold text-dark">
                <i class="fas fa-boxes me-1"></i> Manage Products
            </a>
            <a asp-action="Orders" class="btn btn-primary fw-semibold">
                <i class="fas fa-list-check me-1"></i> Manage Orders
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-store me-1"></i> Storefront
            </a>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Revenue -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 p-3 bg-white border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Revenue</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">$@Model.TotalRevenue.ToString("N2")</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fas fa-dollar-sign fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Orders -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 p-3 bg-white border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Orders</span>
                        <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalOrders</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fas fa-shopping-bag fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Orders -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 p-3 bg-white border-start border-warning border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Pending Orders</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@Model.PendingOrdersCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customers -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100 p-3 bg-white border-start border-info border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Customers</span>
                        <h3 class="fw-bold text-info mb-0 mt-1">@Model.TotalCustomersCount</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders Section -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-history me-2 text-secondary"></i>Recent Orders</h5>
            <a asp-action="Orders" class="btn btn-sm btn-outline-primary fw-semibold">View All Orders &rarr;</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-secondary">
                        <tr>
                            <th class="ps-3">Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">#@order.OrderId</td>
                                    <td>
                                        <div class="fw-semibold">@(order.User != null ? $"{order.User.FirstName} {order.User.LastName}" : "Guest")</div>
                                        <small class="text-muted">@(order.User?.Email ?? "N/A")</small>
                                    </td>
                                    <td class="small text-muted">@order.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                    <td class="fw-bold text-dark">$@order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        @if (order.OrderStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-hourglass-start me-1"></i>Pending</span>
                                        }
                                        else if (order.OrderStatus == "Processing")
                                        {
                                            <span class="badge bg-info text-dark"><i class="fas fa-cogs me-1"></i>Processing</span>
                                        }
                                        else if (order.OrderStatus == "Shipped")
                                        {
                                            <span class="badge bg-primary"><i class="fas fa-shipping-fast me-1"></i>Shipped</span>
                                        }
                                        else if (order.OrderStatus == "Completed" || order.OrderStatus == "Delivered")
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>@order.OrderStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>@order.OrderStatus</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="PrintInvoice" asp-route-id="@order.OrderId" target="_blank" class="btn btn-sm btn-outline-dark me-1" title="Print 80mm Slip">
                                            <i class="fas fa-print"></i>
                                        </a>
                                        <a asp-action="Orders" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i> No orders recorded yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
