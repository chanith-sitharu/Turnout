@model TurnoutStore.Data.Order
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Packing Slip #@Model.OrderId - The Turnout Store</title>
    <style>
        /* ========================================================
           80mm THERMAL RECEIPT PRINTER STYLES
           ======================================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #000000;
            background-color: #ffffff;
            line-height: 1.3;
            padding: 10px;
        }

        .receipt-container {
            width: 80mm;
            max-width: 80mm;
            margin: 0 auto;
            padding: 5px;
            background: #ffffff;
        }

        .text-center { text-align: center; }
        .text-end { text-align: right; }
        .text-start { text-align: left; }
        .fw-bold { font-weight: bold; }

        .store-title {
            font-size: 15px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .divider {
            border-top: 1px dashed #000;
            margin: 6px 0;
            display: block;
        }

        .divider-double {
            border-top: 2px solid #000;
            margin: 6px 0;
            display: block;
        }

        /* Items Table */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin: 4px 0;
        }

        .items-table th {
            text-align: left;
            border-bottom: 1px dashed #000;
            padding-bottom: 3px;
        }

        .items-table td {
            padding: 3px 0;
            vertical-align: top;
        }

        .item-sku {
            font-size: 10px;
            color: #333;
        }

        /* Summary Section */
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin: 2px 0;
        }

        .total-row {
            font-size: 14px;
            font-weight: bold;
            margin: 4px 0;
        }

        /* Barcode Simulation */
        .barcode-box {
            margin: 10px 0 5px 0;
            text-align: center;
        }

        .barcode-lines {
            display: inline-block;
            height: 35px;
            width: 70%;
            background: repeating-linear-gradient(
                90deg,
                #000 0px,
                #000 2px,
                transparent 2px,
                transparent 4px,
                #000 4px,
                #000 7px,
                transparent 7px,
                transparent 9px,
                #000 9px,
                #000 13px,
                transparent 13px,
                transparent 15px
            );
        }

        /* On-Screen Action Toolbar (Hidden during printing) */
        .no-print {
            background-color: #f1f5f9;
            border: 1px solid #cbd5e1;
            padding: 8px 12px;
            margin-bottom: 15px;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 13px;
        }

        .btn-print {
            background-color: #0f172a;
            color: #ffffff;
            border: none;
            padding: 6px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-print:hover { background-color: #1e293b; }

        .btn-close-win {
            background-color: transparent;
            color: #64748b;
            border: 1px solid #cbd5e1;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        /* Thermal Printer Direct Formatting */
        @@media print {
            @@page {
                margin: 0;
                size: 80mm auto;
            }

            body {
                padding: 0;
                margin: 0;
            }

            .receipt-container {
                width: 100%;
                max-width: 100%;
                padding: 3mm 4mm;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- On-Screen Controls (Auto-Hidden upon Print) -->
    <div class="receipt-container no-print">
        <div class="fw-bold">80mm Packing Slip Preview</div>
        <div>
            <button class="btn-print" onclick="window.print()">🖨️ Print</button>
            <button class="btn-close-win" onclick="window.close()">Close</button>
        </div>
    </div>

    <!-- 80mm RECEIPT CONTAINER -->
    <div class="receipt-container">
        <!-- Header -->
        <div class="text-center">
            <div class="store-title">THE TURNOUT MODEL RAILWAY</div>
            <div style="font-size: 10px; font-weight: bold;">PRECISION SCALE MINIATURES &amp; DIORAMAS</div>
            <div style="margin-top: 3px;">Cemetery Road, 18th Mile Post Junction,</div>
            <div>Western Province, Sri Lanka</div>
            <div style="margin-top: 2px;">Tel/WhatsApp: +94 70 385 6824</div>
            <div>Hours: Wed - Sat (10:00 AM - 6:00 PM)</div>
        </div>

        <div class="divider"></div>

        <!-- Order Metadata -->
        <div>
            <div class="summary-row">
                <span>ORDER REF:</span>
                <span class="fw-bold">#@Model.OrderId</span>
            </div>
            <div class="summary-row">
                <span>DATE:</span>
                <span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            <div class="summary-row">
                <span>CUSTOMER:</span>
                <span>@(Model.User != null ? $"{Model.User.FirstName} {Model.User.LastName}" : "Customer")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.User?.PhoneNumber))
            {
                <div class="summary-row">
                    <span>PHONE:</span>
                    <span>@Model.User.PhoneNumber</span>
                </div>
            }
        </div>

        <div class="divider"></div>

        <!-- Shipping Destination -->
        <div>
            <div class="fw-bold">SHIP TO:</div>
            <div style="padding-left: 5px; word-break: break-word;">
                @Model.ShippingAddress
            </div>
        </div>

        <div class="divider-double"></div>

        <!-- Items Table -->
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 55%;">ITEM / DESCRIPTION</th>
                    <th style="width: 15%; text-align: center;">QTY</th>
                    <th style="width: 30%; text-align: right;">AMOUNT</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OrderItems != null && Model.OrderItems.Any())
                {
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div>@(item.Product?.Name ?? $"Product #{item.ProductId}")</div>
                                <div class="item-sku">SKU: @(item.Product?.Sku ?? "N/A")</div>
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">$@item.Subtotal.ToString("F2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-2">Item details attached to invoice</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="divider-double"></div>

        <!-- Financial Summary -->
        <div>
            <div class="summary-row">
                <span>SUBTOTAL:</span>
                <span>$@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div class="summary-row">
                <span>SHIPPING:</span>
                <span>FREE (INSURED)</span>
            </div>
            <div class="divider"></div>
            <div class="summary-row total-row">
                <span>TOTAL:</span>
                <span>$@Model.TotalAmount.ToString("F2")</span>
            </div>
            <div class="summary-row" style="font-size: 11px;">
                <span>STATUS:</span>
                <span class="fw-bold text-uppercase">@(Model.PaymentStatus ?? "PAID") / @(Model.OrderStatus ?? "PENDING")</span>
            </div>
        </div>

        <div class="divider"></div>

        <!-- Barcode & Thank You Footer -->
        <div class="text-center">
            <div class="barcode-box">
                <div class="barcode-lines"></div>
                <div style="font-size: 10px; letter-spacing: 2px;">*ORD-@Model.OrderId*</div>
            </div>

            <div style="margin-top: 6px; font-weight: bold;">THANK YOU FOR YOUR ORDER!</div>
            <div style="font-size: 10px; margin-top: 3px;">
                Please inspect miniature parts upon arrival.<br />
                Report fragile transit issues within 30 days.
            </div>
            <div class="divider"></div>
            <div style="font-size: 9px; color: #555;">PACKED WITH ARTISAN CARE</div>
        </div>
    </div>

    <!-- Auto-Print Trigger on Load -->
    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>
